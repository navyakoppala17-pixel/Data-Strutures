#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

int hash(int key) {
    return key % SIZE;
}

int main() {
    int n, key, index;

    for(int i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    printf("Enter number of keys: ");
    scanf("%d", &n);

    for(int i = 0; i < n; i++) {
        printf("Enter key: ");
        scanf("%d", &key);

        index = hash(key);

        while(hashTable[index] != -1)
            index = (index + 1) % SIZE;

        hashTable[index] = key;
    }

    printf("Hash Table:\n");

    for(int i = 0; i < SIZE; i++)
        printf("%d : %d\n", i, hashTable[i]);

    return 0;
}
